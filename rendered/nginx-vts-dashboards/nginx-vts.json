{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "targets": [
        {
          "expr": "sum(nginx_vts_main_connections{cluster=\"$cluster\", job=~\"$job\", namespace=~\"$namespace\", pod=~\"$pod\", status=~\"active|writing|reading|waiting\"}) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "title": "Server Connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 2,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "targets": [
        {
          "expr": "sum(irate(nginx_vts_server_requests_total{cluster=\"$cluster\", job=~\"$job\", namespace=~\"$namespace\", pod=~\"$pod\", host=~\"^$host$\", code!=\"total\"}[5m])) by (code)",
          "legendFormat": "{{code}}"
        }
      ],
      "title": "Server Requests",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 3,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "targets": [
        {
          "expr": "sum(irate(nginx_vts_server_bytes_total{cluster=\"$cluster\", job=~\"$job\", namespace=~\"$namespace\", pod=~\"$pod\", host=~\"^$host$\"}[5m])) by (direction)",
          "legendFormat": "{{direction}}"
        }
      ],
      "title": "Server Bytes",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["k8s", "app", "L1"],
  "templating": {
