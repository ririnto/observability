{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "CPU Usage",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "core"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/PodRequests/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#e02f44",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/PodLimits/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#ff780a",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": false
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "v13.0.0",
      "targets": [
        {
          "expr": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container!~\"POD|\"}) by (container)",
          "legendFormat": "{{container}}"
        },
        {
          "expr": "sum(\nkube_pod_container_resource_requests{resource=\"cpu\", cluster=\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "PodRequests"
        },
        {
          "expr": "sum(\nkube_pod_container_resource_limits{resource=\"cpu\", cluster=\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "PodLimits"
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
