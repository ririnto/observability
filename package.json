{
  "name": "observability",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:alert-parity": "go tool task check:alert-parity",
    "check:alertmanager": "go tool task check:alertmanager",
    "check:dashboard": "go tool task check:dashboard",
    "check:formal-layout": "pnpm --filter @observability/formal-verification run check:formal-layout",
    "check:formal-layout-regressions": "node .claude/skills/formal-verification/scripts/check-layout.test.ts",
    "check:generated": "go tool task check:generated",
    "check:golangci-lint": "go tool task check:go",
    "check:jsonnetfmt": "go tool task check:jsonnet",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:rules": "go tool task check:rules",
    "check:shfmt": "go tool task check:shell",
    "check:statecharts": "pnpm --filter @observability/formal-verification run check:statecharts",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "check:workflow-input-defaults": "go tool task check:workflow-input-defaults",
    "fix": "run-p fix:*",
    "fix:jsonnetfmt": "go tool jsonnetfmt -i mixins/*.jsonnet mixins/*.libsonnet",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:shfmt": "go tool shfmt -w scripts tests",
    "fix:ultracite": "ultracite fix",
    "generate": "go tool task generate",
    "render:statecharts": "pnpm --filter @observability/formal-verification run render:statecharts"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
